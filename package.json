{
  "name": "logit",
  "productName": "LogIT",
  "version": "3.2.0",
  "description": "Single-user, local-only desktop time logger. The log is the product.",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test tests/",
    "icons": "node scripts/make-icon.mjs",
    "build:renderer": "vite build",
    "start": "npm run icons && npm run build:renderer && electron .",
    "dist": "npm run icons && npm run build:renderer && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.13",
    "@fontsource/inter-tight": "^5.0.18",
    "@fontsource/source-serif-4": "^5.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.logit.app",
    "productName": "LogIT",
    "directories": { "output": "release" },
    "files": [
      "dist/**",
      "src/main/**",
      "src/shared/**",
      "src/preload/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Windows-Installer.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": "universal" }],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macOS.${ext}",
      "title": "Drag LogIT to Applications",
      "background": "build/dmg-background.png",
      "window": { "width": 540, "height": 380 },
      "iconSize": 96,
      "contents": [
        { "x": 140, "y": 167, "type": "file" },
        { "x": 400, "y": 167, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-Linux.${ext}"
    }
  }
}
